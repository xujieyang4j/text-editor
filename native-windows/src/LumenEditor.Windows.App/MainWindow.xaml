<Window
    x:Class="LumenEditor.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumenEditor.Windows.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="文本编辑器(徐洁阳) Native for Windows">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto"
          AutomationProperties.AutomationId="LumenEditorRoot"
          AutomationProperties.Name="Lumen Editor workspace"
          AutomationProperties.AccessibilityView="Content">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="New_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="Open_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="Save_Invoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseDocument_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextDocument_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousDocument_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="Replace_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control,Shift" Invoked="FindInFiles_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="FindNext_Invoked" />
            <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="FindPrevious_Invoked" />
            <KeyboardAccelerator Key="F4" Invoked="FindResultNext_Invoked" />
            <KeyboardAccelerator Key="F4" Modifiers="Shift" Invoked="FindResultPrevious_Invoked" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="GoToLine_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="CommandPalette_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="GotoAnything_Invoked" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="SelectNextOccurrence_Invoked" />
            <KeyboardAccelerator Key="F3" Modifiers="Menu" Invoked="SelectAllOccurrences_Invoked" />
            <KeyboardAccelerator Key="I" Modifiers="Shift,Menu" Invoked="AddCursorsLineEnds_Invoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Control,Menu" Invoked="AddCursorAbove_Invoked" />
            <KeyboardAccelerator Key="Down" Modifiers="Control,Menu" Invoked="AddCursorBelow_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="NavigateBack_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="NavigateForward_Invoked" />
        </Grid.KeyboardAccelerators>
        <CommandBar x:Name="MainCommandBar" DefaultLabelPosition="Right">
            <AppBarButton Icon="Page" Label="New" Click="New_Click" />
            <AppBarButton Icon="OpenFile" Label="Open" Click="Open_Click" />
            <AppBarButton Label="Open Encoding" Click="OpenWithEncoding_Click" />
            <AppBarButton Label="Open Recent" Click="OpenRecent_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
            <AppBarButton Label="Save As" Click="SaveAs_Click" />
            <AppBarButton Label="Save All" Click="SaveAll_Click" />
            <AppBarButton Label="Auto Save" Click="AutoSave_Click" />
            <AppBarButton Icon="Undo" Label="Undo" Click="Undo_Click" />
            <AppBarButton Icon="Redo" Label="Redo" Click="Redo_Click" />
            <AppBarButton Icon="Cancel" Label="Close" Click="CloseDocument_Click" />
            <AppBarButton Label="Reopen Closed" Click="ReopenClosed_Click" />
            <AppBarButton Label="Encoding" Click="Encoding_Click" />
            <AppBarButton Label="Reopen Encoding" Click="ReopenEncoding_Click" />
            <AppBarButton Label="Line Endings" Click="LineEnding_Click" />
            <AppBarButton Label="Trim Whitespace" Click="TrimWhitespace_Click" />
            <AppBarButton Label="Final Newline" Click="FinalNewline_Click" />
            <AppBarButton Label="Edit Lines" Click="EditLines_Click" />
            <AppBarButton Label="Edit More" Click="EditMore_Click" />
            <AppBarButton Label="Macro" Click="Macro_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Find" Label="Find" Click="Find_Click" />
            <AppBarButton Icon="Find" Label="Find in Files" Click="FindInFiles_Click" />
            <AppBarButton Icon="Setting" Label="Settings" Click="Settings_Click" />
            <AppBarButton Label="Go to Line" Click="GoToLine_Click" />
            <AppBarButton Label="Goto Anything" Click="GotoAnything_Click" />
            <AppBarButton Label="Symbols" Click="GotoSymbol_Click" />
            <AppBarButton Label="Project Symbols" Click="GotoProjectSymbol_Click" />
            <AppBarButton Label="Back" Click="NavigateBack_Click" />
            <AppBarButton Label="Forward" Click="NavigateForward_Click" />
            <AppBarButton Label="Commands" Click="CommandPalette_Click" />
            <AppBarSeparator />
            <AppBarButton Label="1 Pane" Click="LayoutSingle_Click" />
            <AppBarButton Label="2 Panes" Click="LayoutColumns2_Click" />
            <AppBarButton Label="3 Panes" Click="LayoutColumns3_Click" />
            <AppBarButton Label="4 Panes" Click="LayoutGrid4_Click" />
            <AppBarButton Label="Move Next" Click="MoveDocumentNextPane_Click" />
            <AppBarButton Label="Clone Next" Click="CloneDocumentNextPane_Click" />
            <AppBarButton Label="Split Selected" Click="SplitSelectedTabs_Click" />
            <AppBarButton Label="Focus Next" Click="FocusNextPane_Click" />
            <AppBarSeparator />
            <AppBarButton Label="Build" Click="Build_Click" />
            <AppBarButton Label="Git" Click="Git_Click" />
            <AppBarButton Label="Terminal" Click="Terminal_Click" />
            <AppBarButton Label="Language" Click="LanguageServer_Click" />
            <AppBarButton Label="Plugins" Click="Plugins_Click" />
            <AppBarButton Label="Preview" Click="Preview_Click" />
        </CommandBar>
        <Grid x:Name="FindPanel" Grid.Row="1" Visibility="Collapsed"
              Padding="8,6" ColumnSpacing="6" RowSpacing="6"
              ColumnDefinitions="220,Auto,Auto,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto">
            <TextBox x:Name="FindInput" PlaceholderText="Find" TextChanged="FindInput_TextChanged"
                     AutomationProperties.Name="Find text" />
            <Button Grid.Column="1" Content="Previous" Click="FindPrevious_Click" />
            <Button Grid.Column="2" Content="Next" Click="FindNext_Click" />
            <ToggleButton x:Name="MatchCaseToggle" Grid.Column="3" Content="Aa" Click="FindOption_Click"
                          ToolTipService.ToolTip="Match case" AutomationProperties.Name="Match case" />
            <ToggleButton x:Name="WholeWordToggle" Grid.Column="4" Content="Word" Click="FindOption_Click"
                          ToolTipService.ToolTip="Whole word" AutomationProperties.Name="Whole word" />
            <ToggleButton x:Name="RegexToggle" Grid.Column="5" Content=".*" Click="FindOption_Click"
                          ToolTipService.ToolTip="Regular expression" AutomationProperties.Name="Regular expression" />
            <Button Grid.Column="6" Content="History" Click="FindHistory_Click" />
            <Button Grid.Column="7" HorizontalAlignment="Right" Content="Close" Click="CloseFind_Click" />

            <TextBox x:Name="ReplaceInput" Grid.Row="1" PlaceholderText="Replace"
                     AutomationProperties.Name="Replace text" />
            <Button Grid.Row="1" Grid.Column="1" Content="Replace" Click="ReplaceNext_Click" />
            <Button Grid.Row="1" Grid.Column="2" Content="Replace All" Click="ReplaceAll_Click" />
            <TextBlock x:Name="FindStatus" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="5"
                       VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Grid x:Name="WorkspaceSearchPanel" Grid.Row="1" Visibility="Collapsed"
              Padding="8,6" ColumnSpacing="6" RowSpacing="6" RowDefinitions="Auto,Auto"
              ColumnDefinitions="260,Auto,Auto,Auto,Auto,Auto,*">
            <TextBox x:Name="WorkspaceSearchInput" PlaceholderText="Find in files"
                     AutomationProperties.Name="Find in files text" />
            <Button Grid.Column="1" Content="Find All" Click="SearchWorkspace_Click" />
            <ToggleButton x:Name="WorkspaceMatchCaseToggle" Grid.Column="2" Content="Aa"
                          ToolTipService.ToolTip="Match case" AutomationProperties.Name="Match case" />
            <ToggleButton x:Name="WorkspaceWholeWordToggle" Grid.Column="3" Content="Word"
                          ToolTipService.ToolTip="Whole word" AutomationProperties.Name="Whole word" />
            <ToggleButton x:Name="WorkspaceRegexToggle" Grid.Column="4" Content=".*"
                          ToolTipService.ToolTip="Regular expression" AutomationProperties.Name="Regular expression" />
            <Button Grid.Column="5" Content="History" Click="WorkspaceHistory_Click" />
            <Button Grid.Column="6" HorizontalAlignment="Right" Content="Close"
                    Click="CloseWorkspaceSearch_Click" />
            <TextBox x:Name="WorkspaceReplacementInput" Grid.Row="1" PlaceholderText="Replace in files"
                     AutomationProperties.Name="Replace in files text" />
            <Button Grid.Row="1" Grid.Column="1" Content="Preview Replace" Click="PreviewWorkspaceReplace_Click" />
            <Button Grid.Row="1" Grid.Column="2" Content="Apply Preview" Click="ApplyWorkspaceReplace_Click" />
            <Button Grid.Row="1" Grid.Column="3" Content="Undo Replace" Click="UndoWorkspaceReplace_Click" />
        </Grid>
        <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed"
              Padding="8,6" ColumnSpacing="10" RowSpacing="6"
              ColumnDefinitions="Auto,100,Auto,100,Auto,120,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Font size" VerticalAlignment="Center" />
            <NumberBox x:Name="FontSizeSetting" Grid.Column="1" Minimum="8" Maximum="40" SpinButtonPlacementMode="Compact" />
            <TextBlock Grid.Column="2" Text="Tab size" VerticalAlignment="Center" />
            <NumberBox x:Name="TabSizeSetting" Grid.Column="3" Minimum="1" Maximum="16" SpinButtonPlacementMode="Compact" />
            <TextBlock Grid.Column="4" Text="Max file MB" VerticalAlignment="Center" />
            <NumberBox x:Name="MaxFileSizeSetting" Grid.Column="5" Minimum="1" Maximum="200" SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="InsertSpacesSetting" Grid.Column="6" Content="Insert spaces" VerticalAlignment="Center" />
            <CheckBox x:Name="WordWrapSetting" Grid.Column="7" Content="Word wrap" VerticalAlignment="Center" />
            <Button Grid.Column="8" Content="Apply" Click="ApplySettings_Click" />
            <Button Grid.Column="9" HorizontalAlignment="Right" Content="Close" Click="CloseSettings_Click" />
            <TextBlock Grid.Row="1" Text="Auto save" VerticalAlignment="Center" />
            <ComboBox x:Name="AutoSaveSetting" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                      AutomationProperties.Name="Auto save mode">
                <ComboBoxItem Content="Off" />
                <ComboBoxItem Content="After delay" />
                <ComboBoxItem Content="On focus change" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Delay ms" VerticalAlignment="Center" />
            <NumberBox x:Name="AutoSaveDelaySetting" Grid.Row="1" Grid.Column="5"
                       Minimum="250" Maximum="60000" SmallChange="250"
                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="Auto save delay in milliseconds" />
            <CheckBox x:Name="LineNumbersSetting" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Line numbers" VerticalAlignment="Center" />
            <CheckBox x:Name="WhitespaceSetting" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                      Content="Whitespace" VerticalAlignment="Center" />
            <CheckBox x:Name="MinimapSetting" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2"
                      Content="Minimap" VerticalAlignment="Center" />
            <CheckBox x:Name="IndentGuidesSetting" Grid.Row="2" Grid.Column="6"
                      Content="Indent guides" VerticalAlignment="Center" />
            <CheckBox x:Name="TrailingWhitespaceSetting" Grid.Row="2" Grid.Column="7" Grid.ColumnSpan="2"
                      Content="Trailing whitespace" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rulers" VerticalAlignment="Center" />
            <TextBox x:Name="RulersSetting" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                     PlaceholderText="80, 100" AutomationProperties.Name="Vertical ruler columns" />
            <TextBlock Grid.Row="3" Grid.Column="5" Text="Color scheme" VerticalAlignment="Center" />
            <ComboBox x:Name="ColorSchemeSetting" Grid.Row="3" Grid.Column="6" Grid.ColumnSpan="3"
                      AutomationProperties.Name="Editor color scheme">
                <ComboBoxItem Content="Dark" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Solarized Dark" />
                <ComboBoxItem Content="Dracula" />
            </ComboBox>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Build command" VerticalAlignment="Center" />
            <TextBox x:Name="BuildCommandSetting" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="8"
                     MaxLength="1000" PlaceholderText="Executable followed by arguments"
                     AutomationProperties.Name="Default build command" />
        </Grid>
        <Grid x:Name="LanguageServerSettingsPanel" Grid.Row="1" Visibility="Collapsed"
              Padding="8,6" ColumnSpacing="6" ColumnDefinitions="140,220,300,Auto,*">
            <TextBox x:Name="LanguageIdSetting" PlaceholderText="Language ID (e.g. typescript)"
                     AutomationProperties.Name="Language server language ID" />
            <TextBox x:Name="LanguageServerCommandSetting" Grid.Column="1" PlaceholderText="Server executable"
                     AutomationProperties.Name="Language server executable" />
            <TextBox x:Name="LanguageServerArgumentsSetting" Grid.Column="2" PlaceholderText="One argument per line"
                     AutomationProperties.Name="Language server arguments" />
            <Button Grid.Column="3" Content="Save" Click="SaveLanguageServerSettings_Click" />
            <Button Grid.Column="4" HorizontalAlignment="Right" Content="Close" Click="CloseLanguageServerSettings_Click" />
        </Grid>
        <Grid x:Name="WorkspaceEditorGrid" Grid.Row="2" ColumnDefinitions="280,*">
            <Grid x:Name="WorkspaceSidebar" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                  RowDefinitions="Auto,*,Auto,180">
                <CommandBar DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False">
                    <AppBarButton Icon="OpenFile" Label="Open Folder" Click="OpenFolder_Click" />
                    <AppBarButton Icon="Refresh" Label="Refresh Workspace" Click="RefreshWorkspace_Click" />
                    <AppBarButton Icon="Delete" Label="Remove Folder" Click="RemoveFolder_Click" />
                    <AppBarButton Icon="Add" Label="New File" Click="NewWorkspaceFile_Click" />
                    <AppBarButton Label="New Folder" Click="NewWorkspaceFolder_Click" />
                    <AppBarButton Label="Rename" Click="RenameWorkspaceItem_Click" />
                    <AppBarButton Label="Recycle" Click="RecycleWorkspaceItem_Click" />
                    <AppBarButton Label="Reveal" Click="RevealWorkspaceItem_Click" />
                </CommandBar>
                <TreeView x:Name="WorkspaceTreeView" Grid.Row="1" SelectionMode="Single"
                          CanDragItems="False" CanReorderItems="False"
                          Expanding="WorkspaceTree_Expanding" ItemInvoked="WorkspaceTree_ItemInvoked"
                          AutomationProperties.Name="Workspace files" />
                <TextBlock Grid.Row="2" Text="OPEN DOCUMENTS" Padding="12,8,8,4"
                           FontSize="12" Opacity="0.7" />
                <ListView x:Name="DocumentList" Grid.Row="3" DisplayMemberPath="TabTitle"
                          SelectionMode="Extended"
                          SelectionChanged="DocumentList_SelectionChanged"
                          AutomationProperties.Name="Open documents" />
                <Grid x:Name="OutlinePanel" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}"
                      RowDefinitions="Auto,*">
                    <Grid Padding="12,6" ColumnDefinitions="*,Auto">
                        <TextBlock Text="DOCUMENT OUTLINE" FontSize="12" Opacity="0.7" />
                        <Button Grid.Column="1" Content="Close" Click="CloseOutline_Click" />
                    </Grid>
                    <ListView x:Name="OutlineList" Grid.Row="1" DisplayMemberPath="Display"
                              IsItemClickEnabled="True" ItemClick="Outline_ItemClick"
                              AutomationProperties.Name="Document outline symbols" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,Auto" ColumnDefinitions="*,*">
                <Grid x:Name="EditorPaneGrid" ColumnDefinitions="*,*,*" RowDefinitions="*,*">
                    <Border x:Name="Pane0Host" Grid.RowSpan="2" Grid.ColumnSpan="3"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border x:Name="LineNumberGutter0" Width="48" Padding="0,0,6,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Canvas x:Name="LineNumberCanvas0" Tag="0"
                                        AutomationProperties.Name="Line numbers and fold controls for editor pane 1" />
                            </Border>
                            <local:NativeCodeEditor x:Name="Editor0" Grid.Column="1" Tag="0" AcceptsReturn="True"
                                     TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                                     AutomationProperties.Name="Editor pane 1" />
                            <Canvas x:Name="DecorationCanvas0" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="WhitespaceCanvas0" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MultiSelectionCanvas0" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MinimapCanvas0" Grid.Column="2" Tag="0" Width="100" HorizontalAlignment="Right"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Tapped="Minimap_Tapped"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                    <Border x:Name="Pane1Host" Visibility="Collapsed"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border x:Name="LineNumberGutter1" Width="48" Padding="0,0,6,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Canvas x:Name="LineNumberCanvas1" Tag="1"
                                        AutomationProperties.Name="Line numbers and fold controls for editor pane 2" />
                            </Border>
                            <local:NativeCodeEditor x:Name="Editor1" Grid.Column="1" Tag="1" AcceptsReturn="True"
                                     TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                                     AutomationProperties.Name="Editor pane 2" />
                            <Canvas x:Name="DecorationCanvas1" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="WhitespaceCanvas1" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MultiSelectionCanvas1" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MinimapCanvas1" Grid.Column="2" Tag="1" Width="100" HorizontalAlignment="Right"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Tapped="Minimap_Tapped"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                    <Border x:Name="Pane2Host" Visibility="Collapsed"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border x:Name="LineNumberGutter2" Width="48" Padding="0,0,6,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Canvas x:Name="LineNumberCanvas2" Tag="2"
                                        AutomationProperties.Name="Line numbers and fold controls for editor pane 3" />
                            </Border>
                            <local:NativeCodeEditor x:Name="Editor2" Grid.Column="1" Tag="2" AcceptsReturn="True"
                                     TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                                     AutomationProperties.Name="Editor pane 3" />
                            <Canvas x:Name="DecorationCanvas2" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="WhitespaceCanvas2" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MultiSelectionCanvas2" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MinimapCanvas2" Grid.Column="2" Tag="2" Width="100" HorizontalAlignment="Right"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Tapped="Minimap_Tapped"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                    <Border x:Name="Pane3Host" Visibility="Collapsed"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border x:Name="LineNumberGutter3" Width="48" Padding="0,0,6,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Canvas x:Name="LineNumberCanvas3" Tag="3"
                                        AutomationProperties.Name="Line numbers and fold controls for editor pane 4" />
                            </Border>
                            <local:NativeCodeEditor x:Name="Editor3" Grid.Column="1" Tag="3" AcceptsReturn="True"
                                     TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                                     AutomationProperties.Name="Editor pane 4" />
                            <Canvas x:Name="DecorationCanvas3" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="WhitespaceCanvas3" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MultiSelectionCanvas3" Grid.Column="1" IsHitTestVisible="False"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Canvas x:Name="MinimapCanvas3" Grid.Column="2" Tag="3" Width="100" HorizontalAlignment="Right"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" Tapped="Minimap_Tapped"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="PreviewPanel" Grid.Column="1" Visibility="Collapsed">
                    <WebView2 x:Name="MarkdownPreview" Visibility="Collapsed"
                              AutomationProperties.Name="Markdown preview" />
                    <TextBox x:Name="PreviewOutput" Visibility="Collapsed" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Document preview" />
                </Grid>
                <Grid x:Name="WorkspaceResultsPanel" Grid.Row="1" Visibility="Collapsed"
                      MaxHeight="260" MinHeight="120" RowDefinitions="Auto,*"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="WorkspaceSearchStatus" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Close Results" Click="CloseWorkspaceResults_Click" />
                    </Grid>
                    <ListView x:Name="WorkspaceResultsList" Grid.Row="1" DisplayMemberPath="Display"
                              IsItemClickEnabled="True" ItemClick="WorkspaceResults_ItemClick"
                              AutomationProperties.Name="Find in files results" />
                </Grid>
                <Grid x:Name="BuildPanel" Grid.Row="1" Visibility="Collapsed" MinHeight="160" MaxHeight="320"
                      RowDefinitions="Auto,*" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock x:Name="BuildStatus" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Stop" Click="StopBuild_Click" />
                        <Button Grid.Column="2" Content="Close" Click="CloseBuild_Click" />
                    </Grid>
                    <TextBox x:Name="BuildOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Cascadia Mono" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Build output" />
                </Grid>
                <Grid x:Name="GitPanel" Grid.Row="1" Visibility="Collapsed" MinHeight="200" MaxHeight="360"
                      RowDefinitions="Auto,*" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock x:Name="GitStatusText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Stage" Click="StageGit_Click" />
                        <Button Grid.Column="2" Content="Unstage" Click="UnstageGit_Click" />
                        <Button Grid.Column="3" Content="Discard" Click="DiscardGit_Click" />
                        <Button Grid.Column="4" Content="Stage Hunk" Click="StageGitHunk_Click" />
                        <Button Grid.Column="5" Content="Discard Hunk" Click="DiscardGitHunk_Click" />
                        <Button Grid.Column="6" Content="History" Click="GitHistory_Click" />
                        <Button Grid.Column="7" Content="Blame" Click="GitBlame_Click" />
                        <Button Grid.Column="8" Content="Branch" Click="SwitchGitBranch_Click" />
                        <Button Grid.Column="9" Content="New Branch" Click="CreateGitBranch_Click" />
                        <Button Grid.Column="10" Content="Commit" Click="CommitGit_Click" />
                        <Button Grid.Column="11" Content="Close" Click="CloseGit_Click" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="260,*" RowDefinitions="Auto,*">
                        <ListView x:Name="GitFilesList" Grid.RowSpan="2" DisplayMemberPath="Display"
                                  SelectionMode="Extended" SelectionChanged="GitFiles_SelectionChanged"
                                  AutomationProperties.Name="Git changed files" />
                        <ComboBox x:Name="GitHunkPicker" Grid.Column="1" DisplayMemberPath="Header"
                                  SelectionChanged="GitHunkPicker_SelectionChanged"
                                  AutomationProperties.Name="Git diff hunks" />
                        <TextBox x:Name="GitDiffOutput" Grid.Row="1" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Cascadia Mono" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Git diff" />
                    </Grid>
                </Grid>
                <Grid x:Name="TerminalPanel" Grid.Row="1" Visibility="Collapsed" MinHeight="200" MaxHeight="360"
                      RowDefinitions="Auto,*,Auto" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock x:Name="TerminalStatus" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Start" Click="StartTerminal_Click" />
                        <Button Grid.Column="2" Content="Stop" Click="StopTerminal_Click" />
                        <Button Grid.Column="3" Content="Clear" Click="ClearTerminal_Click" />
                        <Button Grid.Column="4" Content="Close" Click="CloseTerminal_Click" />
                    </Grid>
                    <TextBox x:Name="TerminalOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Cascadia Mono" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Terminal output" />
                    <TextBox x:Name="TerminalInput" Grid.Row="2" PlaceholderText="Type a command and press Enter"
                             KeyDown="TerminalInput_KeyDown" AutomationProperties.Name="Terminal command input" />
                </Grid>
                <Grid x:Name="LanguageServerPanel" Grid.Row="1" Visibility="Collapsed" MinHeight="180" MaxHeight="340"
                      RowDefinitions="Auto,*" ColumnDefinitions="*,300" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock x:Name="LanguageServerStatus" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Hover" Click="LspHover_Click" />
                        <Button Grid.Column="2" Content="Definition" Click="LspDefinition_Click" />
                        <Button Grid.Column="3" Content="References" Click="LspReferences_Click" />
                        <Button Grid.Column="4" Content="Rename" Click="LspRename_Click" />
                        <Button Grid.Column="5" Content="Apply Rename" Click="ApplyLspRename_Click" />
                        <Button Grid.Column="6" Content="Undo Rename" Click="UndoLspRename_Click" />
                        <Button Grid.Column="7" Content="Stop / Close" Click="CloseLanguageServer_Click" />
                    </Grid>
                    <TextBox x:Name="LanguageServerOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Cascadia Mono" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Language server output" />
                    <ListView x:Name="LanguageDiagnosticsList" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Display"
                              IsItemClickEnabled="True" ItemClick="LanguageDiagnostic_ItemClick"
                              AutomationProperties.Name="Language server diagnostics" />
                </Grid>
                <Grid x:Name="PluginsPanel" Grid.Row="1" Visibility="Collapsed" MinHeight="180" MaxHeight="340"
                      RowDefinitions="Auto,*" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="10,6" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock x:Name="PluginsStatus" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1" Content="Install Local" Click="InstallPlugin_Click" />
                        <Button Grid.Column="2" Content="Insert Snippet" Click="InsertSnippet_Click" />
                        <Button Grid.Column="3" Content="Close" Click="ClosePlugins_Click" />
                    </Grid>
                    <ListView x:Name="PluginsList" Grid.Row="1" DisplayMemberPath="Display"
                              AutomationProperties.Name="Installed declarative plugins" />
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="StatusBar" Grid.Row="3" Padding="8,4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
            <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PositionStatus" Grid.Column="1" />
            <TextBlock x:Name="EncodingStatus" Grid.Column="2" />
            <TextBlock x:Name="LineEndingStatus" Grid.Column="3" />
            <Button x:Name="LanguageStatus" Grid.Column="4" Click="LanguageStatus_Click" />
        </Grid>
    </Grid>
</Window>
