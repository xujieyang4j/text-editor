<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <AssemblyName>LumenEditor.Windows.Worker</AssemblyName>
    <RootNamespace>LumenEditor.Windows.Worker</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LumenEditor.Windows.Core/LumenEditor.Windows.Core.csproj" />
  </ItemGroup>
</Project>
